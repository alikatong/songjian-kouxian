# ============================================================
#  后端环境变量  — 复制此文件为 .env 并填写真实值
# ============================================================

NODE_ENV=development
PORT=3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xxgame
DB_USER=xxgame_app
DB_PASSWORD=replace_with_a_strong_password
DB_SSL=false
DB_SCHEMA=xxgame

# JWT（生产环境请替换为随机长字符串）
JWT_SECRET=replace_with_a_random_secret_at_least_64_chars_long
JWT_EXPIRES_IN=7d
# Web 会话 Cookie 的最长有效期（毫秒），默认 7 天；生产环境必须通过 HTTPS 访问
AUTH_COOKIE_MAX_AGE_MS=604800000
ADMIN_JWT_SECRET=replace_with_a_separate_random_secret_at_least_64_characters
ADMIN_JWT_EXPIRES_IN=4h
ADMIN_ENVIRONMENT_NAME=production
ADMIN_INSTANCE_ID=songjian-primary

# 前端地址（CORS 白名单；多个地址以英文逗号分隔）
CLIENT_ORIGIN=http://localhost:5173
