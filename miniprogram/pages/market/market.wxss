.market-page { padding-top: 0; }
.modes { min-width: 680rpx; }
.number-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 18rpx; }
.sell-panel .picker { margin-top: 20rpx; }
.list-button { width: 100%; margin-top: 20rpx; }
.market-item { display: flex; margin-bottom: 15rpx; padding: 22rpx; align-items: flex-start; gap: 18rpx; border: 1rpx solid #cac8bd; border-left: 4rpx solid #b4893a; background: #fbfaf6; }
.market-art { width: 104rpx; height: 104rpx; flex: 0 0 auto; border: 1rpx solid #c6c4ba; background: #eeede7; }
.market-content { min-width: 0; flex: 1; }
.market-item.claimed { opacity: .58; }
.entry-head { display: flex; gap: 14rpx; align-items: flex-start; justify-content: space-between; }
.market-action { display: flex; margin-top: 18rpx; align-items: center; justify-content: space-between; }
.price { color: #a34a36; font-size: 27rpx; font-weight: 700; }
