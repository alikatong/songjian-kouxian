<view class="page market-page">
  <scroll-view scroll-x class="resource-strip"><view class="resource"><text class="resource-label">可用灵石</text><text class="resource-value">{{balance}}</text></view></scroll-view>
  <view class="page-head"><view><text class="page-kicker">灵石流转</text><view class="page-title">{{title}}</view><text class="page-subtitle">买卖有凭，货财两清</text></view></view>
  <scroll-view scroll-x><view class="segmented modes"><button class="segment {{mode === 'shop' ? 'active' : ''}}" data-mode="shop" bindtap="switchMode">商店</button><button class="segment {{mode === 'auction' ? 'active' : ''}}" data-mode="auction" bindtap="switchMode">寄售</button><button class="segment {{mode === 'sell' ? 'active' : ''}}" data-mode="sell" bindtap="switchMode">上架</button><button class="segment {{mode === 'mail' ? 'active' : ''}}" data-mode="mail" bindtap="switchMode">信箱</button></view></scroll-view>

  <view class="panel gold sell-panel" wx:if="{{mode === 'sell'}}"><view class="panel-title">寄售上架</view><text class="panel-copy">货物售出后，所得灵石会通过信箱发放。</text><picker range="{{sellable}}" range-key="displayName" value="{{assetIndex}}" bindchange="onAsset"><view class="picker">{{sellable.length ? sellable[assetIndex].displayName + ' · 持有 ' + sellable[assetIndex].quantity : '暂无可售物品'}}</view></picker><view class="number-row"><view class="field"><text class="field-label">数量</text><input class="input" type="number" value="{{quantity}}" data-field="quantity" bindinput="onNumber" /></view><view class="field"><text class="field-label">单价</text><input class="input" type="number" value="{{unitPrice}}" data-field="unitPrice" bindinput="onNumber" /></view></view><text class="source-line">上架收取总价 2% 手续费；成交后扣除 5% 交易税。</text><button class="primary list-button" bindtap="listAsset" loading="{{busy === 'list'}}" disabled="{{busy || !sellable.length}}">确认上架</button></view>

  <view class="loading" wx:if="{{loading}}">正在查阅...</view>
  <view class="empty" wx:elif="{{mode !== 'sell' && !items.length}}">当前没有内容</view>
  <view class="market-list" wx:if="{{mode !== 'sell' && !loading}}">
    <view class="market-item {{mode === 'mail' && item.claimed ? 'claimed' : ''}}" wx:for="{{items}}" wx:key="id">
      <image class="market-art" wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit" />
      <view class="market-content">
      <view class="entry-head"><view><text class="item-name">{{item.displayName}}</text><text class="item-meta" wx:if="{{mode === 'shop'}}">{{item.major_realm}} · {{item.description}}</text><text class="item-meta" wx:elif="{{mode === 'auction'}}">{{item.quantity}} 件 · 卖家 {{item.seller_name}}</text><text class="item-meta" wx:else>{{item.claimed ? '已领取' : '待领取'}} · {{item.created_at}}</text></view><text class="rarity-tag rarity-{{item.rarity}}" wx:if="{{mode !== 'mail'}}">{{item.rarityName}}</text></view>
      <text class="panel-copy" wx:if="{{mode === 'mail'}}">{{item.body}}</text><text class="source-line" wx:if="{{mode === 'mail' && item.attachment}}">附件：{{item.attachment}}</text><text class="source-line" wx:if="{{mode === 'shop'}}">{{item.source_description}}</text>
      <view class="market-action"><text class="price" wx:if="{{mode !== 'mail'}}">{{item.displayPrice}} 灵石</text><button class="secondary mini" wx:if="{{mode === 'shop'}}" data-index="{{index}}" data-action="buy-shop" bindtap="action" disabled="{{busy || !item.canBuy}}">购买</button><button class="secondary mini" wx:elif="{{mode === 'auction'}}" data-index="{{index}}" data-action="buy-auction" bindtap="action" disabled="{{busy || (!item.is_own && !item.canBuy)}}">{{item.is_own ? '撤拍' : '购买'}}</button><button class="secondary mini" wx:else data-index="{{index}}" data-action="claim" bindtap="action" disabled="{{busy || item.claimed}}">{{item.claimed ? '已领取' : '领取附件'}}</button></view>
      </view>
    </view>
  </view>
  <view class="pager" wx:if="{{mode !== 'sell' && totalPages > 1}}"><button class="secondary mini" bindtap="previous" disabled="{{page <= 1}}">上一页</button><text>{{page}} / {{totalPages}} · 共 {{total}} 项</text><button class="secondary mini" bindtap="next" disabled="{{page >= totalPages}}">下一页</button></view>
</view>
