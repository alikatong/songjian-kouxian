<view class="page profile-page">
  <scroll-view scroll-x class="resource-strip" wx:if="{{mode === 'profile' && character}}"><view class="resource" wx:for="{{resources}}" wx:key="label"><text class="resource-label">{{item.label}}</text><text class="resource-value">{{item.value}}</text></view></scroll-view>
  <view class="page-head"><view><text class="page-kicker">命数与同道</text><view class="page-title">{{mode === 'profile' ? '人物志' : '道友与传音'}}</view><text class="page-subtitle">{{user.username}}</text></view></view>
  <view class="segmented"><button class="segment {{mode === 'profile' ? 'active' : ''}}" data-mode="profile" bindtap="switchMode">人物</button><button class="segment {{mode === 'social' ? 'active' : ''}}" data-mode="social" bindtap="switchMode">道友</button></view>
  <view class="loading" wx:if="{{loading}}">正在读取...</view>

  <block wx:if="{{!loading && mode === 'profile' && character}}">
    <view class="profile-hero"><view class="profile-art-stage"><image wx:if="{{character.portrait}}" src="{{character.portrait}}" mode="aspectFit" binderror="onPortraitError" /><view class="portrait-placeholder" wx:else>命</view></view><view class="profile-hero-copy"><text class="profile-name">{{character.name}}</text><text>{{character.title}} · {{character.realm}}</text><text>{{character.origin.name}}</text></view></view>
    <view class="panel"><view class="panel-title">出身命数</view><text class="panel-copy">{{character.origin.description}}</text><view class="bonus-list"><text wx:for="{{originBonuses}}" wx:key="label">{{item.label}} +{{item.value}}</text></view></view>
    <view class="panel green"><view class="panel-title">根骨战力</view><view class="stat-grid"><view class="stat"><text class="stat-label">气血</text><text class="stat-value">{{character.stats.hp}} / {{character.stats.hp_max}}</text></view><view class="stat"><text class="stat-label">攻击</text><text class="stat-value">{{character.stats.atk}}</text></view><view class="stat"><text class="stat-label">防御</text><text class="stat-value">{{character.stats.def}}</text></view><view class="stat"><text class="stat-label">身法</text><text class="stat-value">{{character.stats.spd}}</text></view></view></view>
    <view class="panel"><view class="panel-title">当前功法</view><text class="item-name">{{character.active_technique.name || '未修功法'}}</text><text class="panel-copy detail-copy">{{character.active_technique.description || '前往功法谱选择主修功法。'}}</text></view>
    <view class="panel"><view class="panel-title">当前器装</view><view class="equipment-line" wx:for="{{equipment}}" wx:key="slot"><image class="equipment-thumb" wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit" /><view class="item-glyph" wx:else>{{item.slot === '武器位' ? '武' : '护'}}</view><view><text class="muted">{{item.slot}}</text><text class="item-name block">{{item.item ? item.item.name : '尚未装备'}}</text><text class="item-meta" wx:if="{{item.item}}">攻击 +{{item.item.bonuses.atk}} · 防御 +{{item.item.bonuses.def}} · 气血 +{{item.item.bonuses.hp}}</text></view></view></view>
    <button class="secondary logout" bindtap="logout">退出登录</button>
  </block>

  <block wx:if="{{!loading && mode === 'social'}}">
    <view class="segmented social-tabs"><button class="segment {{socialMode === 'chat' ? 'active' : ''}}" data-mode="chat" bindtap="switchSocialMode">传音</button><button class="segment {{socialMode === 'friends' ? 'active' : ''}}" data-mode="friends" bindtap="switchSocialMode">道友录</button></view>
    <block wx:if="{{socialMode === 'chat'}}"><scroll-view scroll-x class="channel-scroll"><view class="channel-list"><button class="channel {{chatChannel === 'global' ? 'active' : ''}}" data-username="" data-label="天下传音" bindtap="chooseChannel">天下传音</button><button class="channel {{chatFriend === item.username ? 'active' : ''}}" wx:for="{{friends}}" wx:key="username" data-username="{{item.username}}" data-label="{{item.character_name || item.username}}" bindtap="chooseChannel">{{item.character_name || item.username}}</button></view></scroll-view><view class="panel chat-panel"><view class="panel-title">{{chatTitle}}</view><scroll-view scroll-y class="chat"><view class="message {{item.username === user.username ? 'own' : ''}}" wx:for="{{messages}}" wx:key="id"><text class="sender">{{item.character_name || item.username}}</text><text class="message-body">{{item.body}}</text><text class="message-time">{{item.created_at}}</text></view><view class="empty" wx:if="{{!messages.length}}">此处尚无传音</view></scroll-view><view class="send-row"><input value="{{message}}" data-field="message" bindinput="onInput" maxlength="200" placeholder="{{chatChannel === 'global' ? '向天下道友传音' : '传音给 ' + chatTitle}}" /><button class="primary" bindtap="sendMessage" disabled="{{busy || !message}}">发送</button></view></view></block>

    <block wx:else><view class="panel"><view class="panel-title">寻找道友</view><view class="search-row"><input class="input" value="{{search}}" data-field="search" bindinput="onInput" bindconfirm="searchPlayers" confirm-type="search" placeholder="账号或角色名" /><button class="secondary search-button" bindtap="searchPlayers" loading="{{busy === 'search'}}">搜索</button></view><view class="list-item row" wx:for="{{searchResults}}" wx:key="username"><view><text class="item-name">{{item.character_name || item.username}}</text><text class="item-meta">{{item.username}} · {{item.realm}}</text></view><button class="secondary relation-button" data-username="{{item.username}}" bindtap="requestFriend" disabled="{{item.relation !== 'none' || busy}}">{{item.relationName}}</button></view></view>
    <view class="panel" wx:if="{{incoming.length}}"><view class="panel-title">待回应申请</view><view class="list-item row" wx:for="{{incoming}}" wx:key="id"><text class="item-name">{{item.character_name || item.username}}</text><view class="request-actions"><button class="secondary mini" data-id="{{item.id}}" data-action="reject" bindtap="respond">拒绝</button><button class="primary mini" data-id="{{item.id}}" data-action="accept" bindtap="respond">接受</button></view></view></view>
    <view class="panel"><view class="panel-title">我的道友</view><view class="friend-line" wx:for="{{friends}}" wx:key="username"><image wx:if="{{item.portrait}}" src="{{item.portrait}}" mode="aspectFill" /><view class="item-glyph" wx:else>友</view><view class="item-main"><text class="item-name">{{item.character_name || item.username}}</text><text class="item-meta">{{item.realm}} · {{item.username}}</text></view><button class="secondary mini" data-username="{{item.username}}" data-label="{{item.character_name || item.username}}" bindtap="chooseChannel">传音</button></view><view class="empty" wx:if="{{!friends.length}}">道友录尚空，可搜索玩家发送申请</view><text class="source-line" wx:if="{{outgoing.length}}">等待回应 {{outgoing.length}} 人</text></view></block>
  </block>
</view>
