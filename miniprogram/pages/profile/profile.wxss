.profile-page { padding-top: 0; }
.profile-hero { margin-bottom: 18rpx; overflow: hidden; border: 1rpx solid #8d928b; border-radius: 4rpx; background: #17231b; }
.profile-art-stage { display: flex; height: 760rpx; align-items: center; justify-content: center; background: radial-gradient(circle at 50% 44%, #34483a 0, #17231b 65%); }
.profile-art-stage image { width: 100%; height: 100%; }
.portrait-placeholder { color: #d9c47d; font-family: STSong, SimSun, serif; font-size: 96rpx; }
.profile-hero-copy { position: relative; padding: 24rpx; border-top: 1rpx solid #4b5d50; background: #111a14; color: #e4e7e3; }
.profile-hero-copy text { display: block; margin-top: 4rpx; font-size: 22rpx; }
.profile-name { color: #fff; font-family: STSong, SimSun, serif; font-size: 38rpx !important; font-weight: 700; }
.bonus-list { display: flex; margin-top: 17rpx; flex-wrap: wrap; gap: 10rpx; }
.bonus-list text { padding: 7rpx 11rpx; border: 1rpx solid #c7a65f; color: #745b29; font-size: 21rpx; }
.detail-copy { margin-top: 12rpx; }
.equipment-line, .friend-line { display: flex; padding: 17rpx 0; align-items: center; gap: 14rpx; border-bottom: 1rpx solid #dddbd2; }
.equipment-line:last-child, .friend-line:last-child { border-bottom: 0; }
.block { display: block; margin-top: 4rpx; }
.logout { width: 100%; }
.social-tabs { margin-top: -2rpx; }
.channel-scroll { margin-bottom: 16rpx; white-space: nowrap; }
.channel-list { display: inline-flex; gap: 10rpx; }
.channel { min-height: 62rpx; padding: 0 20rpx; border: 1rpx solid #979e97; background: #fff; color: #4d584f; font-size: 22rpx; line-height: 62rpx; }
.channel.active { background: #26372c; color: #fff; }
.chat { height: 500rpx; margin-bottom: 14rpx; padding: 14rpx; background: #eeede7; }
.message { max-width: 82%; margin-bottom: 14rpx; padding: 13rpx 15rpx; background: #fff; }
.message.own { margin-left: auto; background: #dfeadf; }
.sender, .message-body, .message-time { display: block; }
.sender { color: #a34a36; font-size: 20rpx; font-weight: 700; }
.message-body { margin-top: 5rpx; line-height: 1.55; }
.message-time { margin-top: 5rpx; color: #8a918a; font-size: 18rpx; }
.send-row, .search-row { display: flex; gap: 10rpx; }
.send-row input { height: 70rpx; flex: 1; padding: 0 16rpx; border: 1rpx solid #abb1aa; background: #fff; }
.send-row button { width: 120rpx; min-height: 70rpx; line-height: 70rpx; }
.search-row .input { flex: 1; }
.search-button { width: 126rpx; padding: 0 10rpx; }
.relation-button { width: 158rpx; min-height: 60rpx; padding: 0 8rpx; font-size: 21rpx; line-height: 60rpx; }
.request-actions { display: flex; gap: 8rpx; }
.friend-line image { width: 76rpx; height: 76rpx; border-radius: 3rpx; background: #e6e4dc; }
.equipment-thumb { width: 76rpx; height: 76rpx; flex: 0 0 auto; border: 1rpx solid #bbb9af; background: #eeede7; }
