<view class="character-page">
  <image class="character-bg" src="/assets/login-qingyun.webp" mode="aspectFill" />
  <view class="character-shade"></view>
  <view class="creation" wx:if="{{!created}}"><text class="creation-kicker">落子人间</text><view class="creation-title">立下道号</view><text class="creation-copy">你必定出生在凡人家庭，家境与天性由命数随机决定，差异只在毫厘之间。</text><view class="field"><text class="field-label">道号</text><input class="input" maxlength="12" value="{{name}}" bindinput="onInput" placeholder="输入角色名" /></view><view class="segmented gender"><button class="segment {{gender === 'male' ? 'active' : ''}}" data-gender="male" bindtap="chooseGender">男</button><button class="segment {{gender === 'female' ? 'active' : ''}}" data-gender="female" bindtap="chooseGender">女</button></view><button class="primary create-command" loading="{{busy}}" disabled="{{busy}}" bindtap="create">落子人间</button></view>
  <view class="creation reveal" wx:else><text class="creation-kicker">命数已定</text><view class="creation-title">{{created.origin.name}}</view><image class="origin-portrait" wx:if="{{created.portrait}}" src="{{created.portrait}}" mode="aspectFit" /><text class="origin-name">{{created.name}}</text><text class="creation-copy">{{created.origin.description}}</text><view class="bonus-list"><text wx:for="{{bonuses}}" wx:key="label">{{item.label}} +{{item.value}}</text></view><button class="primary create-command" bindtap="enter">接受命数</button></view>
</view>
