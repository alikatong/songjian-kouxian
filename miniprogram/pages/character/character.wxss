.character-page { position: relative; min-height: 100vh; overflow: hidden; background: #101a13; color: #f5f2e8; }
.character-bg, .character-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.character-shade { background: rgba(7, 18, 11, .72); }
.creation { position: relative; z-index: 1; width: calc(100% - 64rpx); margin: 14vh auto 0; padding: 34rpx; border: 1rpx solid rgba(239, 232, 210, .34); border-top: 5rpx solid #b95a43; border-radius: 4rpx; background: rgba(20, 31, 24, .94); }
.creation-kicker { display: block; color: #d39370; font-size: 21rpx; }
.creation-title { margin: 10rpx 0 14rpx; font-family: STSong, SimSun, serif; font-size: 48rpx; font-weight: 700; }
.creation-copy { display: block; margin-bottom: 26rpx; color: #c7cec7; font-size: 24rpx; line-height: 1.75; }
.creation .field-label { color: #ddc991; }
.creation .input { border-color: rgba(239, 232, 210, .32); background: rgba(5, 13, 8, .54); color: #fff; }
.gender { border-color: rgba(239, 232, 210, .32); background: rgba(5, 13, 8, .42); }
.gender .segment { color: #c8cec8; }
.gender .segment.active { background: #e5d19d; color: #172019; }
.create-command { width: 100%; }
.reveal { margin-top: 7vh; }
.origin-portrait { width: 100%; height: 430rpx; margin-bottom: 20rpx; border-radius: 3rpx; background: #0f1912; }
.origin-name { display: block; margin-bottom: 10rpx; color: #e8d39e; font-family: serif; font-size: 34rpx; }
.bonus-list { display: flex; margin-bottom: 24rpx; flex-wrap: wrap; gap: 10rpx; }
.bonus-list text { padding: 7rpx 11rpx; border: 1rpx solid #bda05b; color: #ead9ab; font-size: 21rpx; }
