<view class="page cultivate-page">
  <scroll-view scroll-x class="resource-strip" wx:if="{{character}}">
    <view class="resource" wx:for="{{resources}}" wx:key="label"><text class="resource-label">{{item.label}}</text><text class="resource-value">{{item.value}}</text></view>
  </scroll-view>

  <view class="loading" wx:if="{{loading && !character}}">正在观照气海...</view>
  <block wx:if="{{character}}">
    <view class="page-head"><view><text class="page-kicker">洞府修行</text><view class="page-title">{{character.realm}}</view><text class="page-subtitle">{{character.name}} · {{character.title}}</text></view><text class="realm">{{character.major_realm}}</text></view>

    <view class="meditation-stage">
      <image class="meditation-art" src="{{meditationArt}}" mode="aspectFit" />
      <view class="qi-aura">
        <view class="qi-flow qi-flow-one"></view><view class="qi-flow qi-flow-two"></view>
        <view class="qi-orbit qi-orbit-outer"></view><view class="qi-orbit qi-orbit-inner"></view><view class="qi-core"></view>
        <view class="qi-mote mote-1"></view><view class="qi-mote mote-2"></view><view class="qi-mote mote-3"></view><view class="qi-mote mote-4"></view><view class="qi-mote mote-5"></view><view class="qi-mote mote-6"></view><view class="qi-mote mote-7"></view><view class="qi-mote mote-8"></view>
      </view>
      <view wx:if="{{legendaryAttack}}" class="legendary-track legendary-track-attack"><image class="legendary-orbit legendary-orbit-attack" src="{{legendaryAttack.image}}" mode="aspectFit" /></view>
      <view wx:if="{{legendaryDefense}}" class="legendary-track legendary-track-defense"><image class="legendary-orbit legendary-orbit-defense" src="{{legendaryDefense.image}}" mode="aspectFit" /></view>
      <view class="meditation-caption"><text>{{character.retreat.active ? '闭关进行中' : '当前灵气速度'}}</text><strong>{{character.retreat.active ? '+' + character.retreat.rate_per_second + ' / 秒' : '+' + character.qi_per_second + ' / 秒'}}</strong></view>
    </view>

    <view class="panel green">
      <text class="panel-copy">{{character.realm_desc}}</text>
      <view class="qi-label"><text>灵气周天</text><text class="value">{{qiText}} / {{requiredText}}</text></view>
      <view class="progress"><view class="progress-bar" style="width: {{qiPercent}}%"></view></view>
      <view class="row qi-meta"><text class="muted">{{character.retreat.active ? '自然修炼已暂停' : character.technique || '无功法加持'}}</text><text class="muted">{{qiPercent}}%</text></view>
    </view>

    <view class="panel retreat-panel {{character.retreat.active ? 'active' : ''}}">
      <view class="panel-title">{{character.retreat.active ? '闭关进行中' : '闭关修炼'}}</view>
      <text class="retreat-value">{{character.retreat.active ? '预计获得 ' + character.retreat.projected_gain + ' 灵气' : '总效率 ×' + character.retreat.total_multiplier}}</text>
      <text class="item-meta">基础 ×{{character.retreat.multiplier}} · 功法 ×{{character.retreat.technique_multiplier}} · 最多结算 {{character.offline_qi_cap_hrs}} 小时</text>
      <button class="secondary full-command" bindtap="toggleRetreat" loading="{{busy}}" disabled="{{busy || (!character.retreat.active && qiPercent >= 100)}}">{{character.retreat.active ? '出关结算' : '开始闭关'}}</button>
    </view>

    <view class="panel gold">
      <view class="row"><view><text class="page-kicker">{{character.breakthrough.is_major ? '大境界冲关' : '小境界突破'}}</text><view class="panel-title chance">成功率 {{chanceText}}</view></view><text class="failure-count">失败经验 {{character.breakthrough_failures}} / 4</text></view>
      <text class="panel-copy">失败损失 {{character.breakthrough.loss_min * 100}}%-{{character.breakthrough.loss_max * 100}}% 灵气{{character.breakthrough.is_major ? '，无保护可能跌境' : ''}}</text>
      <text class="source-line">{{breakthroughSummary}}</text>
      <button class="primary full-command" bindtap="breakthrough" loading="{{busy}}" disabled="{{busy || qiPercent < 100 || character.retreat.active}}">{{qiPercent >= 100 ? '尝试破境' : '灵气未满'}}</button>
    </view>

    <view class="panel">
      <view class="panel-title">主修功法</view>
      <view wx:if="{{character.active_technique}}"><view class="row"><text class="item-name">{{character.active_technique.name}}</text><text class="rarity-tag rarity-{{character.active_technique.rarity}}">{{activeTechniqueRarity}}</text></view><text class="panel-copy technique-copy">{{character.active_technique.description}}</text></view>
      <view class="empty compact" wx:else>尚未选择主修功法</view>
    </view>

    <view class="panel">
      <view class="panel-title">当前装备</view>
      <view class="equipment-line" wx:for="{{equipment}}" wx:key="slot"><image class="equipment-art" wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit" /><view class="item-glyph" wx:else>{{item.slot === '武器位' ? '武' : '护'}}</view><view class="item-main"><text class="muted">{{item.slot}}</text><text class="item-name">{{item.item ? item.item.name : item.empty}}</text><text class="item-meta" wx:if="{{item.item}}">{{item.bonusText}}</text></view><text class="rarity-{{item.item.rarity}}" wx:if="{{item.item}}">{{item.rarityName}}</text></view>
    </view>
  </block>
</view>
