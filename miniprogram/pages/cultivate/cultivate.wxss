.cultivate-page { padding-top: 0; }
.realm { padding: 8rpx 14rpx; border: 1rpx solid #a23d2b; color: #a23d2b; font-size: 22rpx; }
.meditation-stage { position: relative; height: 680rpx; margin: 0 0 18rpx; overflow: hidden; border: 1rpx solid #625d43; border-radius: 4rpx; background: radial-gradient(circle at 50% 62%, #21382e 0, #111a14 68%); isolation: isolate; }
.meditation-art { position: relative; z-index: 1; width: 100%; height: 100%; }
.qi-aura { position: absolute; inset: 0; z-index: 2; overflow: hidden; pointer-events: none; }
.qi-flow { position: absolute; border: 2rpx solid rgba(126, 220, 193, .32); border-radius: 50%; box-shadow: 0 0 18rpx rgba(102, 205, 181, .35); animation: qi-flow 8s linear infinite; }
.qi-flow-one { inset: 18% -24%; }
.qi-flow-two { inset: 31% -34%; border-color: rgba(226, 192, 103, .28); animation-duration: 11s; animation-direction: reverse; }
.qi-orbit { position: absolute; top: 68%; left: 50%; border: 2rpx solid rgba(136, 231, 204, .66); border-radius: 50%; transform: translate(-50%, -50%); box-shadow: 0 0 24rpx rgba(91, 221, 190, .28), inset 0 0 20rpx rgba(226, 192, 103, .16); animation: qi-breathe 3.6s ease-in-out infinite; }
.qi-orbit-outer { width: 58%; height: 32%; }
.qi-orbit-inner { width: 38%; height: 22%; animation-delay: -1.8s; }
.qi-core { position: absolute; top: 68%; left: 50%; width: 66rpx; height: 66rpx; border-radius: 50%; transform: translate(-50%, -50%); background: radial-gradient(circle, #fff8d1 0 8%, #bdeed8 25%, rgba(73,199,171,.25) 56%, transparent 72%); box-shadow: 0 0 28rpx rgba(163,238,211,.8), 0 0 55rpx rgba(224,181,86,.35); animation: qi-core 2.2s ease-in-out infinite; }
.qi-mote { position: absolute; width: 9rpx; height: 9rpx; border-radius: 50%; background: #c8f8e2; box-shadow: 0 0 12rpx #75d7bb, 0 0 22rpx rgba(226,192,103,.6); opacity: 0; animation: qi-gather 4.5s ease-in infinite; }
.mote-1 { left: 12%; top: 22%; animation-delay: -.2s; }.mote-2 { left: 83%; top: 26%; animation-delay: -1.4s; }.mote-3 { left: 21%; top: 48%; animation-delay: -2.8s; }.mote-4 { left: 76%; top: 51%; animation-delay: -3.7s; }.mote-5 { left: 8%; top: 71%; animation-delay: -1.9s; }.mote-6 { left: 91%; top: 68%; animation-delay: -3.1s; }.mote-7 { left: 34%; top: 15%; animation-delay: -4.1s; }.mote-8 { left: 65%; top: 12%; animation-delay: -.9s; }
.legendary-track { position: absolute; z-index: 3; top: 20%; left: 15%; width: 70%; height: 52%; border-radius: 50%; pointer-events: none; }
.legendary-track-attack { animation: legendary-track 8s linear infinite; }
.legendary-track-defense { top: 29%; left: 22%; width: 56%; height: 39%; animation: legendary-track 6.5s linear infinite reverse; }
.legendary-orbit { position: absolute; width: 116rpx; height: 116rpx; padding: 8rpx; border: 2rpx solid rgba(228, 190, 94, .7); border-radius: 50%; background: rgba(12, 23, 16, .78); box-shadow: 0 0 26rpx rgba(228,190,94,.52), 0 0 48rpx rgba(112,211,178,.24); }
.legendary-orbit-attack { top: 50%; left: -58rpx; animation: legendary-upright 8s linear infinite reverse; }
.legendary-orbit-defense { right: -58rpx; bottom: 50%; animation: legendary-upright 6.5s linear infinite; }
.meditation-caption { position: absolute; right: 0; bottom: 0; left: 0; display: flex; padding: 22rpx 24rpx; align-items: center; justify-content: space-between; background: rgba(12, 24, 16, .86); color: #dfe6df; }
.meditation-caption text { font-size: 22rpx; }
.meditation-caption strong { color: #e6ce93; font-size: 28rpx; }
.qi-label { display: flex; margin: 22rpx 0 13rpx; justify-content: space-between; }
.qi-meta { margin-top: 10rpx; }
.retreat-panel.active { border-left-color: #2e7650; background: #f3f8f3; }
.retreat-value { display: block; margin-bottom: 7rpx; font-size: 30rpx; font-weight: 700; }
.full-command { width: 100%; margin-top: 20rpx; }
.chance { margin: 4rpx 0 0; }
.failure-count { color: #7d6640; font-size: 21rpx; }
.technique-copy { margin-top: 14rpx; }
.compact { padding: 22rpx 0; }
.equipment-line { display: flex; padding: 18rpx 0; align-items: center; gap: 16rpx; border-bottom: 1rpx solid #dddbd2; }
.equipment-line:last-child { border-bottom: 0; }
.equipment-line .item-name { display: block; margin-top: 4rpx; }
.equipment-art { width: 76rpx; height: 76rpx; flex: 0 0 auto; border: 1rpx solid #bbb9af; background: #eeede7; }

@keyframes qi-flow { to { transform: rotate(360deg); } }
@keyframes qi-breathe { 0%, 100% { opacity: .3; transform: translate(-50%, -50%) scale(.9); } 50% { opacity: 1; transform: translate(-50%, -50%) scale(1.08); } }
@keyframes qi-core { 0%, 100% { opacity: .58; transform: translate(-50%, -50%) scale(.72); } 50% { opacity: 1; transform: translate(-50%, -50%) scale(1.24); } }
@keyframes qi-gather { 0% { transform: translate(0, 0) scale(.4); opacity: 0; } 18% { opacity: 1; } 72% { opacity: .72; } 100% { left: 50%; top: 68%; transform: translate(-50%, -50%) scale(.08); opacity: 0; } }
@keyframes legendary-track { to { transform: rotate(360deg); } }
@keyframes legendary-upright { to { transform: rotate(360deg); } }
