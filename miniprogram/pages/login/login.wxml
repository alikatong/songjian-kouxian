<view class="auth-page {{mode}}">
  <image class="scene" src="/assets/login-qingyun.webp" mode="aspectFill" />
  <view class="scene-shade"></view>

  <view class="topbar">
    <view class="brand-lockup">
      <image class="brand-mark" src="/assets/songjian-mark.png" mode="aspectFit" />
      <view class="brand-name">
        <text class="brand-cn">松间叩仙</text>
        <text class="brand-en">松风入道</text>
      </view>
    </view>
    <view class="connection ready">
      <view class="connection-dot"></view>
      <text>{{statusText}}</text>
    </view>
  </view>

  <view class="hero-copy">
    <text class="hero-kicker">山门将启</text>
    <text class="hero-title">一念入世</text>
    <text class="hero-title hero-accent">叩问长生</text>
    <view class="hero-rule"></view>
    <text class="hero-description">云深不知处，松间有仙门。</text>
  </view>

  <view class="auth-area">
    <view class="mode-tabs">
      <view class="mode-tab {{mode === 'login' ? 'active' : ''}}" data-mode="login" bindtap="switchMode">登录</view>
      <view class="mode-tab {{mode === 'register' ? 'active' : ''}}" data-mode="register" bindtap="switchMode">注册</view>
    </view>

    <form bindsubmit="handleSubmit">
      <view class="field">
        <text class="field-label">道号</text>
        <input
          class="field-input"
          name="username"
          value="{{username}}"
          maxlength="20"
          placeholder="请输入道号"
          placeholder-class="input-placeholder"
          bindinput="handleUsernameInput"
          confirm-type="next"
        />
      </view>

      <view class="field">
        <text class="field-label">口令</text>
        <input
          class="field-input"
          name="password"
          value="{{password}}"
          password="{{true}}"
          maxlength="128"
          placeholder="{{mode === 'register' ? '至少 8 位' : '请输入口令'}}"
          placeholder-class="input-placeholder"
          bindinput="handlePasswordInput"
          confirm-type="next"
        />
      </view>

      <view class="field" wx:if="{{mode === 'register'}}">
        <text class="field-label">确认口令</text>
        <input
          class="field-input"
          name="confirmPassword"
          value="{{confirmPassword}}"
          password="{{true}}"
          maxlength="128"
          placeholder="请再次输入口令"
          placeholder-class="input-placeholder"
          bindinput="handleConfirmInput"
          confirm-type="done"
        />
      </view>

      <view class="error-line" wx:if="{{errorMessage}}">{{errorMessage}}</view>

      <button class="submit-button" form-type="submit" loading="{{busy}}" disabled="{{busy}}">
        {{busy ? (mode === 'login' ? '正在登录' : '正在注册') : (mode === 'login' ? '踏入山门' : '创建账号')}}
      </button>
    </form>

    <text class="auth-tip">{{mode === 'login' ? '尚无账号？点击上方“注册”创建' : '注册即创建游戏账号，请妥善保管口令'}}</text>
  </view>
</view>
