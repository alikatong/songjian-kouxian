page {
  background: #0b1510;
}

.auth-page {
  position: relative;
  box-sizing: border-box;
  height: 100vh;
  min-height: 1080rpx;
  overflow: hidden;
  color: #f8f5ec;
  background: #0b1510;
}

.scene {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.scene-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(5, 14, 10, .28) 0%, rgba(5, 14, 10, .06) 30%, rgba(5, 14, 10, .3) 58%, rgba(5, 14, 10, .96) 100%);
}

.topbar {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(env(safe-area-inset-top) + 30rpx) 36rpx 0;
}

.brand-lockup {
  display: flex;
  align-items: center;
}

.brand-mark {
  width: 72rpx;
  height: 72rpx;
  margin-right: 16rpx;
  filter: drop-shadow(0 6rpx 14rpx rgba(0, 0, 0, .32));
}

.brand-name {
  min-width: 142rpx;
}

.brand-cn,
.brand-en {
  display: block;
  letter-spacing: 0;
}

.brand-cn {
  font-family: STSong, SimSun, serif;
  font-size: 29rpx;
  font-weight: 700;
}

.brand-en {
  margin-top: 4rpx;
  color: rgba(248, 245, 236, .66);
  font-size: 15rpx;
}

.connection {
  display: flex;
  max-width: 240rpx;
  align-items: center;
  color: rgba(248, 245, 236, .72);
  font-size: 19rpx;
  white-space: nowrap;
}

.connection-dot {
  width: 10rpx;
  height: 10rpx;
  flex: 0 0 auto;
  margin-right: 10rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
}

.connection.ready .connection-dot {
  border-color: #8dc89b;
  background: #8dc89b;
  box-shadow: 0 0 14rpx rgba(141, 200, 155, .68);
}

.hero-copy {
  position: relative;
  z-index: 2;
  margin-top: 22vh;
  padding: 0 48rpx;
  text-shadow: 0 6rpx 24rpx rgba(0, 0, 0, .45);
}

.hero-kicker,
.hero-title,
.hero-description {
  display: block;
  letter-spacing: 0;
}

.hero-kicker {
  margin-bottom: 18rpx;
  color: #d99572;
  font-size: 21rpx;
}

.hero-title {
  font-family: STSong, SimSun, serif;
  font-size: 74rpx;
  font-weight: 700;
  line-height: 1.08;
}

.hero-accent {
  color: #e8d09a;
}

.hero-rule {
  width: 64rpx;
  height: 4rpx;
  margin: 26rpx 0 20rpx;
  background: #b85b43;
}

.hero-description {
  color: rgba(248, 245, 236, .82);
  font-size: 24rpx;
}

.auth-area {
  position: absolute;
  z-index: 3;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 0 40rpx calc(env(safe-area-inset-bottom) + 34rpx);
}

.mode-tabs {
  display: flex;
  width: 100%;
  height: 68rpx;
  margin-bottom: 22rpx;
  border-bottom: 1rpx solid rgba(248, 245, 236, .2);
}

.mode-tab {
  position: relative;
  display: flex;
  width: 50%;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  color: rgba(248, 245, 236, .58);
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.mode-tab.active {
  color: #fff;
}

.mode-tab.active::after {
  position: absolute;
  right: 20%;
  bottom: -1rpx;
  left: 20%;
  height: 4rpx;
  background: #d99572;
  content: '';
}

.field {
  display: flex;
  height: 82rpx;
  margin-bottom: 16rpx;
  align-items: center;
  border: 1rpx solid rgba(248, 245, 236, .24);
  border-radius: 6rpx;
  background: rgba(8, 19, 13, .7);
}

.field-label {
  width: 150rpx;
  flex: 0 0 auto;
  padding-left: 24rpx;
  color: #e8d09a;
  font-size: 23rpx;
  letter-spacing: 0;
}

.field-input {
  width: 100%;
  height: 80rpx;
  padding: 0 22rpx 0 0;
  color: #fff;
  font-size: 26rpx;
  line-height: 80rpx;
  letter-spacing: 0;
}

.input-placeholder {
  color: rgba(248, 245, 236, .34);
}

.submit-button {
  display: block;
  box-sizing: border-box;
  width: 670rpx;
  max-width: 100%;
  min-width: 670rpx;
  height: 92rpx;
  margin: 0 auto;
  padding: 0 24rpx;
  border: 1rpx solid rgba(255, 255, 255, .12);
  border-radius: 6rpx;
  background: #16794a;
  color: #fff;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 90rpx;
  text-align: center;
  letter-spacing: 0;
  box-shadow: 0 14rpx 32rpx rgba(0, 0, 0, .24);
}

.submit-button::after {
  border: 0;
}

.submit-button[disabled] {
  background: rgba(103, 124, 111, .9);
  color: rgba(255, 255, 255, .8);
  opacity: 1;
}

.error-line {
  margin: 0 0 16rpx;
  padding: 12rpx 16rpx;
  border-left: 4rpx solid #d47b63;
  background: rgba(78, 24, 16, .62);
  color: #ffd9cf;
  font-size: 21rpx;
  line-height: 1.45;
}

.auth-tip {
  display: block;
  margin-top: 18rpx;
  color: rgba(248, 245, 236, .48);
  font-size: 19rpx;
  line-height: 1.4;
  text-align: center;
  letter-spacing: 0;
}

.auth-page.register .hero-copy {
  margin-top: 13vh;
}

.auth-page.register .hero-description {
  display: none;
}

@media (max-height: 700px) {
  .hero-copy {
    margin-top: 13vh;
  }

  .hero-title {
    font-size: 64rpx;
  }

  .hero-description {
    display: none;
  }

  .mode-tabs {
    margin-bottom: 14rpx;
  }

  .field {
    height: 72rpx;
    margin-bottom: 12rpx;
  }

  .field-input {
    height: 70rpx;
    line-height: 70rpx;
  }
}
