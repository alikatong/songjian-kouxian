.explore-page { padding-top: 0; }
.rest { width: 126rpx; min-height: 62rpx; padding: 0; line-height: 62rpx; }
.area-scroll { margin-bottom: 18rpx; white-space: nowrap; }
.area-list { display: inline-flex; gap: 14rpx; padding: 2rpx; }
.area-card { position: relative; width: 300rpx; height: 190rpx; overflow: hidden; border: 3rpx solid transparent; border-radius: 4rpx; background: #17231b; }
.area-card.selected { border-color: #d59b55; }
.area-card image { width: 100%; height: 100%; opacity: .82; }
.area-card-copy { position: absolute; right: 0; bottom: 0; left: 0; padding: 15rpx 17rpx; background: rgba(10, 19, 13, .82); color: #fff; }
.area-card-copy text, .area-card-copy small { display: block; }
.area-card-copy text { font-size: 27rpx; font-weight: 700; }
.area-card-copy small { margin-top: 3rpx; color: #c9d0ca; font-size: 19rpx; }
.explore-button { width: 100%; margin-top: 22rpx; }
.event-title { margin: 10rpx 0; font-family: STSong, SimSun, serif; font-size: 38rpx; font-weight: 700; }
.event-copy { display: block; color: #555f57; line-height: 1.75; }
.choice-list { margin-top: 22rpx; }
.choice { width: 100%; margin-top: 12rpx; }
.close-result { width: 100%; margin-top: 22rpx; }
.encounter-art { width: 100%; height: 270rpx; margin-bottom: 20rpx; border-radius: 3rpx; }
.encounter .stat-grid { margin-top: 18rpx; }
.encounter .notice { display: block; margin: 16rpx 0 0; }
.history-tabs { margin-top: 2rpx; }
