<view class="page explore-page">
  <scroll-view scroll-x class="resource-strip" wx:if="{{state}}"><view class="resource"><text class="resource-label">精力</text><text class="resource-value">{{state.character.stamina.current}} / {{state.character.stamina.max}}</text></view><view class="resource"><text class="resource-label">战力</text><text class="resource-value">{{state.combat_power}}</text></view><view class="resource"><text class="resource-label">灵石</text><text class="resource-value">{{state.character.spirit_stones}}</text></view></scroll-view>
  <view class="page-head"><view><text class="page-kicker">踏遍山河</text><view class="page-title">山河游历</view></view><button class="secondary rest" bindtap="rest" disabled="{{busy}}">调息</button></view>
  <view class="segmented"><button class="segment {{mode === 'map' ? 'active' : ''}}" data-mode="map" bindtap="switchMode">游历地图</button><button class="segment {{mode === 'history' ? 'active' : ''}}" data-mode="history" bindtap="switchMode">行迹记录</button></view>
  <view class="loading" wx:if="{{loading && !state}}">正在辨认山川...</view>

  <block wx:if="{{mode === 'map'}}">
    <view class="panel encounter" wx:if="{{encounter}}"><image class="encounter-art" wx:if="{{encounter.art}}" src="{{encounter.art}}" mode="aspectFill" /><text class="page-kicker">突发遭遇 · {{encounter.rankName}}</text><view class="event-title">{{encounter.name}}</view><text class="event-copy">{{encounter.description}}</text><view class="stat-grid"><view class="stat"><text class="stat-label">胜负预估</text><text class="stat-value">{{encounter.forecastName}}</text></view><view class="stat"><text class="stat-label">战力</text><text class="stat-value">{{encounter.player_power}} / {{encounter.enemy_power}}</text></view></view><text class="source-line">战利：{{encounter.rewardText}}</text><text class="notice" wx:if="{{encounter.requirementText}}">尚需：{{encounter.requirementText}}</text><view class="button-row"><button class="secondary" bindtap="avoid" disabled="{{busy}}">避开</button><button class="danger" bindtap="fight" disabled="{{busy || !encounter.can_challenge}}">迎战</button></view></view>

    <view class="panel event" wx:elif="{{event}}"><text class="page-kicker">途中机缘</text><view class="event-title">{{event.title}}</view><text class="event-copy">{{event.body}}</text><view class="choice-list"><button class="secondary choice" wx:for="{{event.choices}}" wx:key="text" data-index="{{index}}" bindtap="choose" disabled="{{busy}}">{{item.text}}</button></view></view>

    <block wx:else>
      <scroll-view scroll-x class="area-scroll"><view class="area-list"><view class="area-card {{item.code === selectedArea ? 'selected' : ''}}" wx:for="{{areas}}" wx:key="code" data-code="{{item.code}}" bindtap="selectArea"><image src="{{item.art}}" mode="aspectFill" /><view class="area-card-copy"><text>{{item.name}}</text><small>{{item.staminaText}}</small></view></view></view></scroll-view>
      <view class="panel green" wx:if="{{selected}}"><view class="row"><view><view class="panel-title">{{selected.name}}</view><text class="muted">建议境界 {{selected.min_realm || selected.major_realm}}</text></view><text class="rarity-tag">{{selected.staminaText}}</text></view><text class="panel-copy">{{selected.description}}</text><button class="primary explore-button" loading="{{busy}}" disabled="{{busy || !selectedArea || state.character.retreat.active || selected.available_event_count === 0}}" bindtap="explore">启程游历</button><button class="secondary explore-button" disabled="{{busy || state.character.retreat.active || state.character.realm_order < selected.max_realm_order}}" bindtap="challengeBoss">{{state.character.realm_order < selected.max_realm_order ? '本境圆满后可挑战首领' : '挑战首领'}}</button></view>
    </block>

    <view class="panel result" wx:if="{{result}}"><view class="event-title">{{result.title}}</view><text class="event-copy">{{result.message}}</text><text class="source-line" wx:if="{{result.rewards}}">{{result.rewards}}</text><button class="primary close-result" bindtap="clearResult">收下结果</button></view>
  </block>

  <block wx:if="{{mode === 'history'}}"><view class="segmented history-tabs"><button class="segment {{historyMode === 'explore' ? 'active' : ''}}" data-mode="explore" bindtap="switchHistory">游历记录</button><button class="segment {{historyMode === 'battle' ? 'active' : ''}}" data-mode="battle" bindtap="switchHistory">战斗记录</button></view><view class="panel"><view class="loading" wx:if="{{loading}}">正在查阅...</view><block wx:elif="{{historyMode === 'explore'}}"><view class="list-item" wx:for="{{history}}" wx:key="id"><view class="row"><text class="item-name">{{item.area_name || item.area_code}}</text><text class="muted">{{item.created_at}}</text></view><text class="item-meta">{{item.event_title || item.result || '完成一次游历'}}</text></view><view class="empty" wx:if="{{!history.length}}">尚无游历记录</view></block><block wx:else><view class="list-item" wx:for="{{battleHistory}}" wx:key="id"><view class="row"><text class="item-name">{{item.enemy_name}}</text><text class="rarity-{{item.result === 'win' ? 'uncommon' : 'legendary'}}">{{item.result === 'win' ? '胜' : '负'}}</text></view><text class="item-meta">灵气 {{item.qi_reward || 0}} · 灵石 {{item.stone_reward || 0}} · {{item.created_at}}</text></view><view class="empty" wx:if="{{!battleHistory.length}}">尚无战斗记录</view></block></view></block>
</view>
