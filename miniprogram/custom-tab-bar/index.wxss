.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  display: flex;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid #c7c9c4;
  background: rgba(251, 250, 245, .98);
  box-shadow: 0 -8rpx 24rpx rgba(20, 31, 24, .1);
}
.tab {
  position: relative;
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #6c746d;
}
.tab.active { background: #f1ede2; color: #a23d2b; }
.tab.pressed { background: #e3ded2; transform: scale(.96); }
.active-line { position: absolute; top: 0; left: 27%; width: 46%; height: 5rpx; background: transparent; }
.tab.active .active-line { background: #a23d2b; }
.tab-icon { width: 46rpx; height: 46rpx; margin-bottom: 3rpx; }
.tab-text { font-size: 20rpx; line-height: 27rpx; }
